---
import type { CollectionEntry } from 'astro:content';

interface Props {
    entry: CollectionEntry<'project'>;
}

const { entry } = Astro.props;
const { title, summary, code, period, homeTags } = entry.data;
---

<a
    href={`/project/${entry.id}`}
    class="group border-line hover:border-signal grid grid-cols-[3.5rem_1fr_auto] items-center gap-4 border-b py-5 transition-colors sm:grid-cols-[4.5rem_1fr_auto] sm:gap-6"
>
    <span class="text-ink-soft font-mono text-xs" title={period}>{code}</span>

    <span class="min-w-0">
        <span class="font-display text-ink group-hover:text-signal block text-lg transition-colors">
            {title}
        </span>
        <span class="text-ink-soft hidden text-sm sm:block">{summary}</span>
    </span>

    <span class="flex items-center gap-4">
        <span class="text-ink-soft hidden font-mono text-[11px] md:block">
            {homeTags.join(' · ')}
        </span>
        <span
            aria-hidden="true"
            class="text-ink-soft group-hover:text-signal transition-all group-hover:translate-x-1"
        >
            →
        </span>
    </span>
</a>
