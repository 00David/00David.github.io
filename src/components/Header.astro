---
import GitHubIcon from '@/components/GitHubIcon.astro';
import LinkedInIcon from '@/components/LinkedInIcon.astro';
import ThemeToggle from '@/components/ThemeToggle.astro';
import { SITE, NAV_LINKS } from '@/site.config';

// SITE.social entries listed here show as an icon; any other one as its label.
const SOCIAL_ICONS: Partial<Record<string, typeof GitHubIcon>> = {
    GitHub: GitHubIcon,
    LinkedIn: LinkedInIcon,
};

const currentPath = Astro.url.pathname;
---

<header class="border-line bg-paper/90 sticky top-0 z-40 border-b backdrop-blur">
    <div class="mx-auto flex max-w-3xl items-center justify-between gap-4 px-6 py-4">
        <a href="/" class="font-display text-ink text-lg font-medium">
            {SITE.name}
        </a>

        <nav class="flex items-center gap-3 sm:gap-5" aria-label="Primary">
            {
                NAV_LINKS.map((link) => {
                    const isActive =
                        currentPath === link.href || currentPath.startsWith(`${link.href}/`);
                    return (
                        <a
                            href={link.href}
                            aria-current={isActive ? 'page' : undefined}
                            class:list={[
                                'font-mono text-xs tracking-wide uppercase transition-colors',
                                isActive ? 'text-signal' : 'text-ink-soft hover:text-ink',
                            ]}
                        >
                            {link.label}
                        </a>
                    );
                })
            }
            {
                SITE.social.map((link) => {
                    const Icon = SOCIAL_ICONS[link.label];
                    return (
                        <a
                            href={link.href}
                            aria-label={Icon ? link.label : undefined}
                            class="hover:text-signal transition-colors"
                            rel="me"
                        >
                            {Icon ? <Icon /> : link.label}
                        </a>
                    );
                })
            }
            <ThemeToggle />
        </nav>
    </div>
</header>
