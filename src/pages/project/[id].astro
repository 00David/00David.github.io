---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Button from '@/components/Button.astro';
import { tagHref } from '@/utils/tags';
import { yearHref } from '@/utils/years';

export async function getStaticPaths() {
    const entries = await getCollection('project', ({ data }) => !data.draft);
    return entries.map((entry) => ({
        params: { id: entry.id },
        props: { entry },
    }));
}

interface Props {
    entry: CollectionEntry<'project'>;
}

const { entry } = Astro.props;
const { title, summary, code, period, tags, url, repo } = entry.data;
const { Content } = await render(entry);
---

<BaseLayout title={title} description={summary}>
    <article class="mx-auto max-w-3xl px-6 pt-16 pb-24 sm:pt-24">
        <a
            href="/project"
            class="text-ink-soft hover:text-signal font-mono text-xs transition-colors"
        >
            ← All projects
        </a>

        <h1 class="font-display text-ink mt-6 max-w-2xl text-3xl font-medium sm:text-4xl">
            {title}
        </h1>

        <dl
            class="border-line text-ink-soft mt-6 flex flex-col gap-2 border-y py-4 font-mono text-xs"
        >
            <div>
                <dt class="inline">Year —&nbsp;</dt>
                <dd class="inline">
                    <a
                        href={yearHref(code)}
                        class="hover:text-signal underline-offset-4 transition-colors hover:underline"
                    >
                        {period}
                    </a>
                </dd>
            </div>
            {
                tags.length > 0 && (
                    <div>
                        <dt class="inline">Stack —&nbsp;</dt>
                        <dd class="inline">
                            {tags.map((tag, i) => (
                                <>
                                    {i > 0 && ', '}
                                    <a
                                        href={tagHref(tag)}
                                        class="hover:text-signal underline-offset-4 transition-colors hover:underline"
                                    >
                                        {tag}
                                    </a>
                                </>
                            ))}
                        </dd>
                    </div>
                )
            }
        </dl>

        <div class="prose prose-sm sm:prose-base mt-10 max-w-2xl">
            <Content />
        </div>

        <div class="mt-10 flex flex-wrap gap-3">
            {
                url && (
                    <Button href={url} variant="solid">
                        Visit live →
                    </Button>
                )
            }
            {
                repo && (
                    <Button href={repo} variant="ghost">
                        View source
                    </Button>
                )
            }
        </div>
    </article>
</BaseLayout>
