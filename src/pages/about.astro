---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { SITE } from '@/site.config';
import { groupTags, tagHref } from '@/utils/tags';
import { yearHref } from '@/utils/years';

const allProjects = await getCollection('project', ({ data }) => !data.draft);

// Every distinct technology used across the projects, grouped by TAG_CATEGORIES.
const toolGroups = groupTags(allProjects.flatMap((entry) => entry.data.tags));

// One entry per academic year, most recent first.
const years = [
    ...new Map(
        [...allProjects]
            .sort((a, b) => b.data.order - a.data.order)
            .map((e) => [e.data.code, e.data.period]),
    ),
].map(([code, period]) => ({ code, period }));
---

<BaseLayout title="About" description={`A bit about ${SITE.name} and the projects on this site.`}>
    <section class="mx-auto max-w-3xl px-6 pt-16 pb-24 sm:pt-24">
        <p class="text-ink-soft mb-6 font-mono text-xs tracking-[0.2em] uppercase">About</p>

        <h1 class="font-display text-ink max-w-xl text-3xl font-medium sm:text-4xl">
            {SITE.role}.
        </h1>

        <div class="prose prose-sm sm:prose-base mt-8 max-w-xl">
            <p>
                This site collects the main projects I have built so far during my degrees, one page
                per project, grouped by academic year.
            </p>
            <p>
                They span deliberately different areas of software — web applications, algorithms,
                simulations — because most of them started as coursework, and each one was a chance
                to learn a new language or toolchain, or get better with one I already knew.
            </p>
        </div>

        <div class="mt-10">
            <p class="text-ink-soft mb-3 font-mono text-xs tracking-[0.2em] uppercase">Years</p>
            <ul class="text-ink-soft space-y-1 font-mono text-xs">
                {
                    years.map(({ code, period }) => (
                        <li>
                            <a
                                href={yearHref(code)}
                                class="hover:text-signal inline-flex gap-4 transition-colors"
                            >
                                <span class="w-6">{code}</span>
                                <span>{period}</span>
                            </a>
                        </li>
                    ))
                }
            </ul>
        </div>

        <div class="mt-10">
            <p class="text-ink-soft mb-3 font-mono text-xs tracking-[0.2em] uppercase">Tools</p>
            <dl class="space-y-4">
                {
                    toolGroups.map((group) => (
                        <div class="flex flex-col gap-2 sm:flex-row sm:items-baseline sm:gap-4">
                            <dt class="text-ink-soft shrink-0 font-mono text-[11px] sm:w-36">
                                {group.label}
                            </dt>
                            <dd>
                                <ul class="flex flex-wrap gap-2">
                                    {group.tags.map((tool) => (
                                        <li>
                                            <a
                                                href={tagHref(tool)}
                                                class="border-line text-ink-soft hover:border-signal hover:text-signal block rounded-full border px-3 py-1 font-mono text-xs transition-colors"
                                            >
                                                {tool}
                                            </a>
                                        </li>
                                    ))}
                                </ul>
                            </dd>
                        </div>
                    ))
                }
            </dl>
        </div>
    </section>
</BaseLayout>
